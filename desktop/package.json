{
  "name": "quicknote",
  "productName": "quicknote",
  "desktopName": "quicknote.desktop",
  "version": "2.1.0",
  "description": "Quicknote",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "start:debug": "electron-forge start --inspect-electron",
    "package": "electron-forge package",
    "make:linux": "electron-forge make --targets deb",
    "make:win": "electron-forge make --targets wix",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": "srilakshmikanthanp",
  "license": "MIT",
  "dependencies": {
    "@quicknote/editor": "*",
    "@reduxjs/toolkit": "^2.12.0",
    "electron-settings": "^4.0.4",
    "open": "^11.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-wix": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
