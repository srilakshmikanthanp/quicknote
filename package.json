{
  "name": "quicknote-monorepo",
  "private": true,
  "description": "QuickNote: the desktop app, its shared editor and its website",
  "license": "MIT",
  "author": "srilakshmikanthanp",
  "workspaces": [
    "electron",
    "packages/*",
    "docs/web"
  ],
  "scripts": {
    "start": "npm start -w electron",
    "start:debug": "npm run start:debug -w electron",
    "make:linux": "npm run make:linux -w electron",
    "make:win": "npm run make:win -w electron",
    "web": "npm run dev -w docs/web",
    "web:build": "npm run build -w docs/web",
    "web:deploy": "npm run deploy -w docs/web"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "electron@45.0.0": true
  }
}
